# =============================================================================
# Environment variables for quality-triage (code-review CLI).
# Copy to `.env` and fill in only what you need. All are OPTIONAL — the default
# Ollama provider needs no keys at all.
# =============================================================================

# --- Generic OpenAI-compatible provider (provider: openai) -------------------
# The key env var is configurable per-backend via `openai.api_key_env` in
# config.yaml. OPENAI_API_KEY is the default fallback for the `openai` provider.
OPENAI_API_KEY=sk-your-openai-key-here
# Optional: override the base URL without editing config.yaml.
# OPENAI_BASE_URL=https://api.openai.com/v1

# Point the `openai` provider at another OpenAI-compatible service by setting
# `openai.base_url` + `openai.api_key_env` in config.yaml and the matching key:
# GROQ_API_KEY=gsk_...
# OPENROUTER_API_KEY=sk-or-...
# TOGETHER_API_KEY=...
# FIREWORKS_API_KEY=...
# MISTRAL_API_KEY=...
# (local llama.cpp / vLLM / LM Studio servers usually accept any key string)

# --- Anthropic provider (provider: anthropic) --------------------------------
ANTHROPIC_API_KEY=sk-ant-your-key-here

# --- GitHub (private repo cloning) -------------------------------------------
GITHUB_TOKEN=ghp_your_token_here

# --- Config discovery override -----------------------------------------------
CODE_REVIEW_CONFIG=./config.yaml

# --- PyPI publishing (LOCAL manual uploads only) -----------------------------
# CI uses Trusted Publishing (OIDC) and needs NO token. These are only for a
# local `uv publish` / `twine upload` fallback. Put the real token in `.env`.
# UV_PUBLISH_TOKEN=pypi-...
# TWINE_USERNAME=__token__
# TWINE_PASSWORD=pypi-...
