# Copy to .env in the project root. LiteLLM reads provider-native keys.
# Only set the keys for the providers you actually use.

# OpenAI / OpenAI-compatible (vLLM, LM Studio, llama.cpp server)
# OPENAI_API_KEY=sk-...

# Anthropic
# ANTHROPIC_API_KEY=sk-ant-...

# Groq
# GROQ_API_KEY=gsk_...

# Google Gemini
# GEMINI_API_KEY=...

# Azure OpenAI
# AZURE_API_KEY=...
# AZURE_API_BASE=https://YOUR_RESOURCE.openai.azure.com
# AZURE_API_VERSION=2024-10-21

# Optional: clone private GitHub repos and raise the issues-API rate limit
# GITHUB_TOKEN=ghp_...

# Optional: override default config discovery
# CODE_REVIEW_CONFIG=./config.yaml

# Optional: enable live LLM integration tests (needs Ollama + LFM2.5 GGUF)
# QUALITY_TRIAGE_LIVE_LLM=1
# QUALITY_TRIAGE_FORCE_TOOLS=1
